---
// 作品列表页：搜索 / 分类 / 标签 / 排序由 WorksExplorer island 负责
// 服务端先渲染第一页（爬虫可见），完整收录靠详情页 + 分类页 + sitemap，不依赖这里的分页
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import WorksExplorer from '@/components/islands/WorksExplorer';
import { absoluteUrl, breadcrumbJsonLd, type Crumb } from '@/lib/seo';
import { countByCategory, getCategories, getWorks, toCardList } from '@/lib/works';
import { site } from '@/site.config';

const [works, categories] = await Promise.all([getWorks(), getCategories()]);
const cards = await toCardList(works, categories);
const counts = countByCategory(works);
const categoryOptions = categories
  .map((category) => ({ id: category.id, name: category.data.name, count: counts.get(category.id) ?? 0 }))
  .filter((option) => option.count > 0);

const title = '全部作品';
const description = `${site.name}的全部 ${works.length} 条作品，覆盖${categoryOptions
  .map((option) => option.name)
  .join('、')}等分类，支持按关键词、分类、标签筛选和排序。`;
const crumbs: Crumb[] = [
  { name: '首页', path: '/' },
  { name: title, path: '/works/' },
];
const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: absoluteUrl('/works/'),
};
---

<BaseLayout title={title} description={description} jsonLd={[breadcrumbJsonLd(crumbs), collectionJsonLd]}>
  <Container class="py-10 sm:py-14">
    <Breadcrumbs crumbs={crumbs} />
    <header class="mt-6 mb-10 max-w-2xl space-y-3">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
      <p class="leading-7 text-muted">{description}</p>
    </header>
    <WorksExplorer client:load works={cards} categories={categoryOptions} />
  </Container>
</BaseLayout>
