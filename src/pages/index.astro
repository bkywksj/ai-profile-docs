---
// 首页：定义句 Hero → 精选作品 → 分类入口 → 最新文章 → 常见问题
// 首页统计数字全部来自真实数据（集合计数），不写死任何营销数字
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import { WorkCard } from '@/components/works/WorkCard';
import { site } from '@/site.config';
import { faqJsonLd, websiteJsonLd, type FaqItem } from '@/lib/seo';
import { categoryPath, countByCategory, getCategories, getWorks, toCardList } from '@/lib/works';
import { formatDate, isoDate } from '@/lib/format';
import { getPosts, postPath } from '@/lib/posts';
import faq from '@/data/faq.json';

const [works, categories, posts] = await Promise.all([getWorks(), getCategories(), getPosts()]);

const featuredSource = works.filter((work) => work.data.featured);
const featured = await toCardList(
  (featuredSource.length > 0 ? featuredSource : works).slice(0, 3),
  categories,
);
const counts = countByCategory(works);
const latestPosts = posts.slice(0, 3);
const faqItems = faq as FaqItem[];

const stats = [
  { label: '作品', value: works.length },
  { label: '分类', value: categories.length },
  { label: '文章', value: posts.length },
];
---

<BaseLayout
  description={site.description}
  jsonLd={faqItems.length > 0 ? [websiteJsonLd(), faqJsonLd(faqItems)] : [websiteJsonLd()]}
>
  <section class="relative overflow-hidden border-b border-line">
    <div
      class="pointer-events-none absolute -top-40 right-[-10%] size-[520px] rounded-full bg-brand/15 blur-3xl"
      aria-hidden="true"
    ></div>
    <Container class="relative py-20 sm:py-28">
      <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-line bg-elevated px-3 py-1 text-xs text-muted">
        <span class="size-1.5 rounded-full bg-brand" aria-hidden="true"></span>
        持续更新中
      </p>
      <h1 class="max-w-3xl text-4xl leading-tight font-semibold tracking-tight text-pretty sm:text-5xl">
        {site.name}
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">{site.tagline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/works/" size="lg">
          浏览全部作品 <ArrowRight class="size-4" aria-hidden="true" />
        </Button>
        <Button href="/posts/" size="lg" variant="secondary">
          阅读文章
        </Button>
      </div>
      <dl class="mt-14 grid max-w-md grid-cols-3 gap-6">
        {stats.map((stat) => (
          <div>
            <dt class="text-sm text-muted">{stat.label}</dt>
            <dd class="mt-1 text-3xl font-semibold tabular-nums">{stat.value}</dd>
          </div>
        ))}
      </dl>
    </Container>
  </section>

  {
    /* 数据为空时（如刚用 module-strip 清空示例、还没接数据源）整块不渲染，避免上线空标题 */
    featured.length > 0 && (
      <Section id="featured" eyebrow="从这里开始" title="精选作品" description="第一次来，建议先看这几条。">
        <a
          slot="action"
          href="/works/"
          class="inline-flex items-center gap-1 text-sm font-medium text-brand-ink hover:underline"
        >
          查看全部 <ArrowRight class="size-4" aria-hidden="true" />
        </a>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((work) => (
            <WorkCard work={work} />
          ))}
        </div>
      </Section>
    )
  }

  {categories.length > 0 && (
    <Section id="categories" title="按分类浏览" class="bg-surface">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        {categories.map((category) => (
          <a
            href={categoryPath(category.id)}
            class="group flex flex-col gap-3 rounded-[var(--radius-card)] border border-line bg-elevated p-6 transition hover:-translate-y-0.5 hover:shadow-[var(--shadow-card-hover)]"
          >
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-semibold">{category.data.name}</h3>
              <span class="text-sm text-muted tabular-nums">{counts.get(category.id) ?? 0} 条</span>
            </div>
            <p class="line-clamp-3 text-sm leading-6 text-muted">{category.data.description}</p>
            <span class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-brand-ink">
              进入分类{' '}
              <ArrowRight
                class="size-4 transition-transform group-hover:translate-x-0.5"
                aria-hidden="true"
              />
            </span>
          </a>
        ))}
      </div>
    </Section>
  )}

  {latestPosts.length > 0 && (
    <Section id="posts" title="最新文章">
      <a
        slot="action"
        href="/posts/"
        class="inline-flex items-center gap-1 text-sm font-medium text-brand-ink hover:underline"
      >
        全部文章 <ArrowRight class="size-4" aria-hidden="true" />
      </a>
      <ul class="divide-y divide-line border-y border-line">
        {latestPosts.map((post) => (
          <li>
            <a
              href={postPath(post.id)}
              class="group flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-6"
            >
              <time datetime={isoDate(post.data.date)} class="shrink-0 text-sm text-muted tabular-nums">
                {formatDate(post.data.date)}
              </time>
              <div>
                <h3 class="font-semibold group-hover:text-brand-ink">{post.data.title}</h3>
                <p class="mt-1 line-clamp-1 text-sm text-muted">{post.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )}

  {faqItems.length > 0 && (
    <Section id="faq" title="常见问题" class="bg-surface">
      <div class="divide-y divide-line rounded-[var(--radius-card)] border border-line bg-elevated">
        {faqItems.map((item) => (
          <details class="group px-6 py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium [&::-webkit-details-marker]:hidden">
              <h3>{item.question}</h3>
              <span class="text-muted transition-transform group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="mt-3 leading-7 text-muted">{item.answer}</p>
          </details>
        ))}
      </div>
    </Section>
  )}
</BaseLayout>
